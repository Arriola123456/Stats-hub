# Variables de entorno opcionales para ENAHO Hub.
# Los códigos de institución (modo B2B) NO van aquí: van en .streamlit/secrets.toml
# (ver .streamlit/secrets.toml.example).

# Puerto del servidor Streamlit (opcional)
# STREAMLIT_SERVER_PORT=8501

# Desactivar la telemetría de Streamlit (opcional)
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
