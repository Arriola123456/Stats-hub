# Copia este archivo a .streamlit/secrets.toml para activar el "modo institución".
# Mapea un código (que la institución comparte con sus usuarios) a su nombre.
# Es solo una demostración del esquema B2B por cuentas: no hay login real.
[instituciones]
"MEF-2024" = "Ministerio de Economía y Finanzas"
"UP-2024" = "Universidad del Pacífico"
"ULIMA-2024" = "Universidad de Lima"
"PUCP-2024" = "Pontificia Universidad Católica del Perú"
